{
  "name": "karaoke-jam-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npx tsx scripts/prerender.ts && npx tsx scripts/generate-sitemap.ts && npm run verify:production-isolation",
    "verify:production-isolation": "node scripts/verify-production-isolation.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest --project=unit",
    "test:ui": "vitest --ui --project=unit",
    "test:run": "vitest run --project=unit",
    "test:coverage": "vitest run --coverage --project=unit",
    "test:i18n": "vitest run --project=unit src/__tests__/i18n.smoke.test.tsx",
    "catalogue:generate": "tsx scripts/component-catalogue/cli.ts --config component-catalogue.config.json",
    "catalogue:check": "tsx scripts/component-catalogue/cli.ts --config component-catalogue.config.json --check",
    "catalogue:baseline": "tsx scripts/component-catalogue/cli.ts --config component-catalogue.config.json --check --require-reviewed-workbench",
    "design-system:check": "tsx scripts/design-system-check/cli.ts --config design-system-check.config.json",
    "design-system:warn": "npm run design-system:check -- --warning",
    "workbench": "storybook dev -p 6006 --no-open --disable-telemetry",
    "workbench:smoke": "storybook dev -p 6006 --ci --smoke-test --disable-telemetry",
    "workbench:typecheck": "tsc -p tsconfig.workbench.json",
    "workbench:build": "npm run workbench:typecheck && storybook build --output-dir storybook-static --disable-telemetry",
    "workbench:test": "npm run workbench:typecheck && vitest run --project=storybook --reporter=default --reporter=json --outputFile.json=private-visual-baselines/actual/workbench-test-results.json",
    "workbench:verify-build": "npm run workbench:typecheck && node scripts/verify-workbench-build.mjs",
    "visual:privacy": "tsx scripts/private-visual/cli.ts --privacy",
    "visual:compare": "tsx scripts/private-visual/cli.ts --compare",
    "visual:update": "VISUAL_BASELINE_UPDATE=1 tsx scripts/private-visual/cli.ts --update",
    "visual:progress": "tsx scripts/private-visual/cli.ts --progress",
    "visual:progress:check": "tsx scripts/private-visual/cli.ts --progress --check"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.87.0",
    "@tailwindcss/vite": "^4.1.17",
    "@vercel/analytics": "^1.6.1",
    "@vercel/functions": "^2.2.13",
    "@vercel/speed-insights": "^1.3.1",
    "axios": "^1.13.2",
    "focus-trap-react": "^11.0.6",
    "framer-motion": "^12.23.26",
    "i18next": "^25.7.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.556.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^2.0.5",
    "react-i18next": "^16.5.0",
    "react-router-dom": "^7.10.1",
    "swr": "^2.3.8",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@fontsource/nunito-sans": "^5.3.0",
    "@sparticuz/chromium": "^143.0.4",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-mcp": "10.6.0",
    "@storybook/addon-themes": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/browser-playwright": "4.0.17",
    "@vitest/ui": "^4.0.17",
    "agent-browser": "^0.6.0",
    "daisyui": "^5.5.5",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "happy-dom": "^20.3.4",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.55.1",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^24.37.3",
    "rollup-plugin-visualizer": "^6.0.5",
    "storybook": "10.6.0",
    "supabase": "^2.76.8",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "npm:rolldown-vite@7.2.2",
    "vitest": "^4.0.17"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.2"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  }
}
