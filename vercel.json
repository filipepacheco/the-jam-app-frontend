{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "jamapp.com.br" }],
      "destination": "https://www.jamapp.com.br/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "object-src 'none'; upgrade-insecure-requests" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/jams/:jamId/dashboard", "destination": "/index.html" },
    { "source": "/jams/:jamId/register", "destination": "/index.html" },
    { "source": "/jams/:jamId", "destination": "/index.html" },
    { "source": "/j/:code", "destination": "/index.html" },
    { "source": "/host/:path*", "destination": "/index.html" },
    { "source": "/profile", "destination": "/index.html" },
    { "source": "/music", "destination": "/index.html" },
    { "source": "/musicians", "destination": "/index.html" },
    { "source": "/auth/:path*", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/:slug", "destination": "/index.html" }
  ]
}
